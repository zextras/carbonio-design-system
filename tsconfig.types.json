{
	"extends": "./tsconfig.json",
	"exclude": [
		"src/**/*.stories.*",
		"src/**/*.test.*",
		"src/tests",
		"**/tsTemplate.ts",
		".storybook",
		"scripts"
	],
	"compilerOptions": {
		"types": ["node"],
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"declarationDir": "types",
		"emitDeclarationOnly": true,
		"allowJs": true,
		"moduleResolution": "node"
	}
}
