{
	"extends": "@zextras/carbonio-ui-configs/rules/typescript.json",
	"include": ["src/**/*", ".storybook/**/*", "scripts/*"],
	"exclude": ["node_modules", "dist"],
	"compilerOptions": {
		"types": ["vitest/globals"],
		"skipLibCheck": true,
		"paths": {
			"@testing-library/user-event/dist/cjs/keyboard/keyMap": [
				"./node_modules/@testing-library/user-event/dist/types/keyboard/keyMap.d.ts"
			]
		},
		"resolveJsonModule": true
	}
}
